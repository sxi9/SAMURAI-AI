# runtime
logs/
__pycache__/
*.pyc

# voice models — large; the setup wizard / dashboard download these automatically
models/*
!models/.gitkeep

# build artifacts
*.zip

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# headless agent working folder
workspace/

# user data and secrets
config.json
data/
gallery/*
!gallery/.gitkeep

# virtual environment created by install.py
.venv/

# PyInstaller output
build/
dist/

# screenshots written by tests/face_shots.js when run without an output folder
tests/face-shots/

.claude/worktrees/

# plugins installed from the store (panel / "install plugin …"); the catalog in plugins/catalog is tracked
plugins/*_pkg/
